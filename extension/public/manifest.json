{
  "manifest_version": 3,
  "name": "Unblank Extension",
  "version": "1.0.0",
  "description": "Chrome extension for Unblank application",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.tsx"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["http://localhost:3000/*", "https://*.unblank.app/*"],
      "js": ["src/content/injector.ts"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "https://*.unblank.app/*"
    ]
  },
  "options_page": "src/options/index.html",
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "UnBlznk.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}
